{
  "packageManager": "npm@11.6.2",
  "name": "mframework",
  "version": "1.0.0",
  "private": true,
  "description": "M Framework — Vue + Nuxt 4 starter and integrations",
  "main": "apps/ecosystem/meeovi-frontend/nuxt.config.ts",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "security:lint": "node packages/plugins/Scripts/security-lint/check.mjs",
    "security:test": "node --env-file=apps/ecosystem/meeovi-frontend/.env packages/plugins/Scripts/prod-tests/security.mjs",
    "preview": "cd apps/ecosystem/meeovi-frontend && npx nuxi preview",
    "postinstall": "node packages/plugins/Scripts/apply-patches.cjs"
  },
  "bin": {
    "meeovi-create-adapter": "packages/core/bin/create-adapter.cjs"
  },
  "keywords": [
    "vue",
    "nuxt",
    "mframework",
    "meeovi"
  ],
  "author": "M Framework",
  "license": "MIT",
  "devDependencies": {
    "patch-package": "^8.0.1",
    "rolldown": "^1.2.9",
    "turbo": "^2.8.11",
    "vite": "^8.3.0"
  },
  "workspaces": [
    "packages/plugins/Admin/alternate-sdk",
    "packages/plugins/CMS-Content/experience-builder",
    "packages/plugins/CMS-Content/meeovi-atproto",
    "packages/plugins/CMS-Content/meeovi-activitypub",
    "packages/plugins/Email-Notifications/meeovi-newsletter",
    "packages/plugins/Marketing-SEO/meeovi-forms",
    "packages/plugins/Marketing-SEO/meeovi-tables",
    "packages/plugins/Admin/meeovi-integrations",
    "packages/plugins/Social/meeovi-discussions",
    "packages/plugins/Social/meeovi-ratings",
    "packages/plugins/Shipping-Fulfillment/meeovi-dropshipping",
    "packages/plugins/Media/meeovi-player",
    "packages/plugins/Themes/starter-template",
    "layers/*",
    "apps/ecosystem/*",
    "packages/plugins/Authentication/auth-sso",
    "packages/plugins/Authentication/auth-scim",
    "packages/plugins/Authentication/auth-generic-oauth",
    "packages/plugins/Authentication/auth-phone-number",
    "packages/plugins/Authentication/auth-anonymous",
    "packages/plugins/CMS-Content/list-type-habit-tracker",
    "packages/plugins/CMS-Content/list-type-kanban",
    "packages/plugins/CMS-Content/list-type-tasklist",
    "packages/plugins/Search/search-algolia",
    "packages/plugins/Search/search-meilisearch",
    "packages/plugins/Search/search-typesense"
  ],
  "dependencies": {
    "@better-auth/core": "1.6.23",
    "@better-auth/telemetry": "1.6.23",
    "@better-auth/utils": "0.4.2",
    "better-auth": "1.6.23",
    "drizzle-orm": "1.0.0-rc.4",
    "flat": "^6.0.1",
    "nuxt": "^4.6.1"
  },
  "overrides": {
    "three": "^0.185.0",
    "@types/three": "^0.185.0",
    "vue": "3.5.41",
    "@vue/reactivity": "3.5.41",
    "@vue/runtime-core": "3.5.41",
    "@vue/runtime-dom": "3.5.41",
    "@vue/shared": "3.5.41",
    "@vue/compiler-core": "3.5.41",
    "@vue/compiler-dom": "3.5.41",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/compiler-ssr": "3.5.41",
    "@vue/server-renderer": "3.5.41",
    "pinia": "4.0.3",
    "better-call": "1.3.7",
    "@svar-ui/lib-dom": "0.13.1"
  }
}
