    "@graphql-typed-document-node/core": "^3.2.0",
    "turbo": "^2.8.11",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "packages/*",
    "packages/modules/*",
    "packages/plugins/*",
    "layers/*",
    "themes/*",
    "docs/*",
    "apps/*"
  ],
  "dependencies": {
    "@apollo/client": "^4.2.6",
    "@better-auth/core": "^1.6.23",
    "@graphql-mesh/runtime": "^0.106.39",
    "@polar-sh/sdk": "^0.47.0",
    "flat": "^6.0.1",
