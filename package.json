{
  "packageManager": "npm@11.6.2",
  "name": "mframework",
  "version": "1.0.0",
  "private": true,
  "description": "M Framework — Vue + Nuxt 4 starter and integrations",
  "main": "apps/ecosystem/meeovi-frontend/nuxt.config.ts",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "preview": "cd apps/ecosystem/meeovi-frontend && npx nuxi preview"
  },
  "bin": {
    "meeovi-create-adapter": "packages/core/bin/create-adapter.cjs"
  },
  "keywords": [
    "vue",
    "nuxt",
    "mframework",
    "meeovi"
  ],
  "author": "M Framework",
  "license": "MIT",
  "devDependencies": {
    "turbo": "^2.8.11"
  },
  "workspaces": [
    "packages/*",
    "packages/modules/*",
    "packages/plugins/*",
    "layers/*",
    "themes/*",
    "apps/ecosystem/*"
  ],
  "dependencies": {
    "@better-auth/core": "1.6.23",
    "@better-auth/telemetry": "1.6.23",
    "@better-auth/utils": "0.4.2",
    "better-auth": "1.6.23",
    "drizzle-orm": "1.0.0-rc.4",
    "flat": "^6.0.1"
  },
  "overrides": {
    "vue": "3.5.41",
    "@vue/reactivity": "3.5.41",
    "@vue/runtime-core": "3.5.41",
    "@vue/runtime-dom": "3.5.41",
    "@vue/shared": "3.5.41",
    "@vue/compiler-core": "3.5.41",
    "@vue/compiler-dom": "3.5.41",
    "@vue/compiler-sfc": "3.5.41",
    "@vue/compiler-ssr": "3.5.41",
    "@vue/server-renderer": "3.5.41",
    "pinia": "4.0.3"
  }
}
