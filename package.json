{
  "packageManager": "npm@11.6.2",
  "name": "mframework",
  "version": "1.0.0",
  "private": true,
  "description": "M Framework — Vue + Nuxt 4 starter and integrations",
  "main": "apps/ecosystem/meeovi-frontend/nuxt.config.ts",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
