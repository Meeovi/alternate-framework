{
  "$schema": "https://app.kilo.ai/config.json",
  "mcp": {
    "figma-dev-mode": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/sse"
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.38"
      ]
    },
    "routing": {
      "tier": "efficient"
    },
    "agent_defaults": {
      "variant": "Low",
      "max_output_tokens": 8192
    }
  },
  "snapshot": false
}