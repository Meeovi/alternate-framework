# Local development environment variables for layers/commerce
# Copy this file to .env and edit values before running.
# See ENVIRONMENT.md for the full reference.

# --- Backend selection --------------------------------------------------
# Which commerce backend the storefront talks to: directus | magento | ...
NUXT_PUBLIC_COMMERCE_BACKEND=directus
DOMAIN=http://localhost:3000
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Directus CMS ------------------------------------------------------
DIRECTUS_URL=http://localhost:8055
NUXTUS_DIRECTUS_STATIC_TOKEN=

# --- Magento (when NUXT_PUBLIC_COMMERCE_BACKEND=magento) --------------
# Read by the `adapter-magento/module` registered in nuxt.config.ts (its
# `magento` config key) — these are the only two vars it actually uses.
# The live storefront: MAGENTO_GRAPHQL_URL=https://meeovi.com/graphql
MAGENTO_GRAPHQL_URL=
MAGENTO_STORE_CODE=

# --- Generic REST commerce adapter ----------------------------------
COMMERCE_REST_ENDPOINT=
COMMERCE_API_TOKEN=

# --- WordPress / WooCommerce feed (optional) -----------------------
WORDPRESS_URL=
WORDPRESS_TOKEN=

# --- Currencies -----------------------------------------------------
# Comma-separated ISO codes; first entry is the default
NUXT_PUBLIC_CURRENCIES=USD,EUR,GBP

# --- PayPal -----------------------------------------------------
# The default payment provider (checkout, refunds, licences).
# NUXT_PAYPAL_MODE / NUXT_PUBLIC_PAYPAL_MODE: sandbox | live (keep them equal)
NUXT_PAYPAL_MODE=sandbox
NUXT_PUBLIC_PAYPAL_MODE=sandbox
NUXT_PAYPAL_CLIENT_ID=
NUXT_PAYPAL_CLIENT_SECRET=
# The id PayPal gives the webhook registered for
# https://<site>/api/payment/paypal/webhooks
NUXT_PAYPAL_WEBHOOK_ID=
NUXT_PUBLIC_SCRIPTS_PAYPAL_CLIENT_ID=

# --- Polar -----------------------------------------------------
# POLAR_MODE / NUXT_POLAR_SERVER: sandbox | production
POLAR_MODE=sandbox
NUXT_POLAR_SERVER=sandbox
NUXT_POLAR_ACCESS_TOKEN=
POLAR_OAT=
NUXT_POLAR_WEBHOOK_SECRET=
POLAR_SUCCESS_URL=http://localhost:3000/checkout/success
NUXT_POLAR_PRODUCT_ID_PRO_MONTH=
NUXT_POLAR_PRODUCT_ID_PRO_YEAR=

# --- Payment feature flag ------------------------------------
# Comma-separated list of enabled providers: paypal,polar
NUXT_PAYMENT=paypal

# --- Shipping (Shippo) --------------------------------------
SHIPPO_API_KEY=
SHIPPO_WEBHOOK_TOKEN=
SHIPPING_ADMIN_TOKEN=
SHIPPO_ORIGIN_NAME=
SHIPPO_ORIGIN_COMPANY=
SHIPPO_ORIGIN_STREET1=
SHIPPO_ORIGIN_STREET2=
SHIPPO_ORIGIN_CITY=
SHIPPO_ORIGIN_STATE=
SHIPPO_ORIGIN_ZIP=
SHIPPO_ORIGIN_COUNTRY=US
SHIPPO_ORIGIN_PHONE=
SHIPPO_ORIGIN_EMAIL=

# --- Transactional email (Resend) --------------------------
NUXT_RESEND_API_KEY=
RESEND_FROM_EMAIL=
