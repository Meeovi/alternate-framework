# Local development environment variables for layers/commerce
# Copy this file to .env and edit values before running.
# See ENVIRONMENT.md for the full reference.

# --- Backend selection --------------------------------------------------
# Which commerce backend the storefront talks to: directus | magento | ...
NUXT_PUBLIC_COMMERCE_BACKEND=directus
DOMAIN=http://localhost:3000
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Directus CMS ------------------------------------------------------
DIRECTUS_URL=http://localhost:8055
NUXTUS_DIRECTUS_STATIC_TOKEN=

# --- Magento (when NUXT_PUBLIC_COMMERCE_BACKEND=magento) --------------
MAGENTO_API_URL=
MAPI_ENDPOINT=
MAGENTO_ADMIN_TOKEN=

# --- Generic REST commerce adapter ----------------------------------
COMMERCE_REST_ENDPOINT=
COMMERCE_API_TOKEN=

# --- WordPress / WooCommerce feed (optional) -----------------------
WORDPRESS_URL=
WORDPRESS_TOKEN=

# --- Currencies -----------------------------------------------------
# Comma-separated ISO codes; first entry is the default
NUXT_PUBLIC_CURRENCIES=USD,EUR,GBP

# --- Stripe -------------------------------------------------------
NUXT_STRIPE_SECRET_KEY=sk_test_...
NUXT_STRIPE_WEBHOOK_SECRET=whsec_...
NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NUXT_PUBLIC_STRIPE_PRICING_TABLE_ID=
NUXT_STRIPE_PRICE_ID_PRO_MONTH=
NUXT_STRIPE_PRICE_ID_PRO_YEAR=

# --- PayPal -----------------------------------------------------
# PAYPAL_MODE: sandbox | live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NUXT_PUBLIC_SCRIPTS_PAYPAL_CLIENT_ID=

# --- Polar -----------------------------------------------------
# POLAR_MODE / NUXT_POLAR_SERVER: sandbox | production
POLAR_MODE=sandbox
NUXT_POLAR_SERVER=sandbox
NUXT_POLAR_ACCESS_TOKEN=
POLAR_OAT=
NUXT_POLAR_WEBHOOK_SECRET=
POLAR_SUCCESS_URL=http://localhost:3000/checkout/success
NUXT_POLAR_PRODUCT_ID_PRO_MONTH=
NUXT_POLAR_PRODUCT_ID_PRO_YEAR=

# --- Payment feature flag ------------------------------------
# Comma-separated list of enabled providers: stripe,paypal,polar
NUXT_PAYMENT=stripe

# --- Shipping (Shippo) --------------------------------------
SHIPPO_API_KEY=
SHIPPO_WEBHOOK_TOKEN=
SHIPPING_ADMIN_TOKEN=
SHIPPO_ORIGIN_NAME=
SHIPPO_ORIGIN_COMPANY=
SHIPPO_ORIGIN_STREET1=
SHIPPO_ORIGIN_STREET2=
SHIPPO_ORIGIN_CITY=
SHIPPO_ORIGIN_STATE=
SHIPPO_ORIGIN_ZIP=
SHIPPO_ORIGIN_COUNTRY=US
SHIPPO_ORIGIN_PHONE=
SHIPPO_ORIGIN_EMAIL=

# --- Transactional email (Resend) --------------------------
NUXT_RESEND_API_KEY=
RESEND_FROM_EMAIL=
