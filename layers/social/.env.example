# Local development environment variables for layers/social
# Copy this file to .env and edit values before running.

# --- Directus CMS (content + auth-backed social data) ---------------------
DIRECTUS_URL=http://localhost:8055
# Static admin token used for privileged server-side reads/writes
NUXTUS_DIRECTUS_STATIC_TOKEN=

# --- Redis (activity feed / follow graph caching) -----------------------
NUXT_REDIS_URL=redis://localhost:6379

# --- RSS / ActivityPub feed export (scripts/export-feed.mjs) -----------
FEED_COLLECTION=posts
FEED_IDENTITY=
FEED_LIMIT=20

# --- MinIO / S3-compatible media storage -------------------------------
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false

# --- Coral comment server (SSO-integrated with layers/auth) ------------
CORAL_SERVER_URL=
# Shared secret from Coral's admin: Configure > Auth > Single Sign On
CORAL_SSO_SECRET=
# Optional — only set if Coral's admin shows a Key ID alongside the secret
CORAL_KEY_ID=

# --- AT Protocol (Bluesky) federation (@mframework/adapter-federation) --
# PDS/AppView useAtprotoClient()'s service-account bootstrap and
# layers/search's atproto provider talk to. Defaults to this deployment's
# hosted PDS when unset.
ATPROTO_SERVICE=https://sky.meeovicms.com
# Service-account app password — powers read paths (timeline, search) that
# aren't acting as a specific signed-in user. Leave unset to disable the
# service-account bootstrap (useAtprotoClient() throws until it's set);
# per-user sign-in works independently via layers/auth's /sign-in/atproto.
ATPROTO_IDENTIFIER=
ATPROTO_APP_PASSWORD=
