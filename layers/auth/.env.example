# Local development environment variables for layers/auth
# Copy this file to .env or .env.local and edit values before running

# PostgreSQL connection used by Prisma via alternate-gateway/core
NUXT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mframework_dev

# BetterAuth secret (MIN 32 chars). Use a random value in production.
BETTER_AUTH_SECRET=2f9b8c3e6a1d4f7e9c2b4a6d8f0e1c3a7b9d2f4a6c8e0b1d3f5a7c9e1b2d3f4

# Base URL used by BetterAuth and some providers
BASE_URL=http://localhost:3006

# Optional Mastodon proxy base URL (if you run a local instance)
MASTO_BASE_URL=

# Redis URL for MCP or session storage if needed
REDIS_URL=

# Comma-separated list of additional trusted origins for CSRF/origin checks
BETTER_AUTH_TRUSTED_ORIGINS=

# Cookie domain for cross-subdomain session cookies (leading dot, e.g. .example.com)
COOKIE_DOMAIN=

# OAuth / Social provider credentials (used by sign-in/sign-up social buttons)
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
BETTER_AUTH_GITHUB_CLIENT_ID=
BETTER_AUTH_GITHUB_CLIENT_SECRET=

# --- AT Protocol (Bluesky) sign-in (POST /sign-in/atproto) --------------
# PDS/AppView the "atproto" better-auth plugin authenticates users against.
# Defaults to this deployment's hosted PDS when unset.
ATPROTO_SERVICE=https://sky.meeovicms.com
