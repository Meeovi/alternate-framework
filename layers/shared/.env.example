# Local development environment variables for layers/shared
# Copy this file to .env and edit values before running.

# --- Site identity (NUXT_PUBLIC_* are exposed to the client) -------------
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SITE_NAME=M Framework
NUXT_PUBLIC_SITE_DESCRIPTION=
NUXT_PUBLIC_SITE_EMAIL=
NUXT_PUBLIC_SITE_AUTHOR=
NUXT_PUBLIC_TWITTER_HANDLE=
NUXT_PUBLIC_API_ENDPOINT=

# --- Directus CMS ------------------------------------------------------
DIRECTUS_URL=http://localhost:8055
NUXTUS_DIRECTUS_STATIC_TOKEN=

# --- Runtime / server ------------------------------------------------
NODE_ENV=development
PORT=3000
# Set SW=true to build the service worker, PWA_DEV=true to enable it in dev
SW=false
PWA_DEV=false

# --- Redis ---------------------------------------------------------
NUXT_REDIS_URL=redis://localhost:6379
REDIS_URL=redis://localhost:6379

# --- Cloudinary (image transforms) -------------------------------
CLOUDINARY_CLOUD_NAME=

# --- Cloudflare Turnstile (CAPTCHA) -----------------------------
NUXT_TURNSTILE_SECRET_KEY=

# --- Newsletter (@mframework/meeovi-newsletter) ---------------
# NEWSLETTER_PROVIDER: directus | mailchimp | console
NEWSLETTER_PROVIDER=directus
# Mailchimp (provider=mailchimp)
NEWSLETTER_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=
# Directus (provider=directus) falls back to DIRECTUS_URL + NUXTUS_DIRECTUS_STATIC_TOKEN
NEWSLETTER_DIRECTUS_COLLECTION=newsletters

# --- Notifications: betternotify transports -------------------
# Generic HTTP transport
HTTP_TRANSPORT_URL=
HTTP_TRANSPORT_API_KEY=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_DESTINATION_EMAIL=

# SendGrid (email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# SMTP (email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_DESTINATION_EMAIL=

# Twilio (SMS)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Firebase Cloud Messaging (web push)
FCM_SERVER_KEY=

# Novu (notification centre)
NOVU_SECRET_KEY=
NUXT_PUBLIC_NOVU_APP_ID=
NUXT_PUBLIC_NOVU_SUBSCRIBER_ID=

# --- Analytics / ads ----------------------------------------
NUXT_PUBLIC_SEGMENT_WRITE_KEY=
GOOGLE_ADSENSE_ID=
GOOGLE_ADSENSE_TEST_MODE=true
