{
 "extends": "../../.nuxt/tsconfig.json",
 "compilerOptions": {
    "verbatimModuleSyntax": false,
    "ignoreDeprecations": "6.0",
    "paths": {
     "~": [
        "./app"
     ],
     "~/*": [
        "./app/*"
     ],
     "@": [
        "./app"
     ],
     "@/*": [
        "./app/*"
     ],
     "#shared": [
        "./shared"
     ],
     "#shared/*": [
        "./shared/*"
     ],
     "#server": [
        "./server"
     ],
     "#server/*": [
        "./server/*"
     ],
     "#imports": [
        "./.nuxt/imports"
     ],
     "#build": [
        "./.nuxt"
     ],
     "#build/*": [
        "./.nuxt/*"
     ],
     "alternate-sdk": [
        "../../packages/plugins/Admin/alternate-sdk/index.ts"
     ],
     "alternate-sdk/contracts": [
        "../../packages/plugins/Admin/alternate-sdk/src/contracts/index.ts"
     ],
     "alternate-sdk/notifications": [
        "../../packages/plugins/Admin/alternate-sdk/src/notifications/index.ts"
     ],
      "alternate-sdk/localization": [
        "../../packages/plugins/Admin/alternate-sdk/src/localization/index.ts"
      ],
      "@mframework/meeovi-forms": [
        "../../packages/plugins/Marketing-SEO/meeovi-forms/src/index.ts"
      ],
      "@mframework/meeovi-forms/*": [
        "../../packages/plugins/Marketing-SEO/meeovi-forms/src/*"
      ]
    }
 },
 "exclude": [
  "**/__tests__/**",
  "**/*.spec.ts",
  "**/*.spec.tsx"
 ],
"include": ["types/**/*.d.ts", "nuxt.config.ts", "plugins", "server", "app.vue"]
}