# Local development environment variables for layers/search
# Copy this file to .env and edit values before running.
#
# Every federated backend is enabled purely by the presence of its connection
# config (see server/providers/*.ts). Leave a block blank to disable that
# backend. OpenSearch is the primary backend and is enabled unless you set
# ALTERNATE_SEARCH_OPENSEARCH_ENABLED=false.

# --- OpenSearch (primary) ---------------------------------------------------
ALTERNATE_SEARCH_OPENSEARCH_ENABLED=true
ALTERNATE_SEARCH_HOST=localhost
ALTERNATE_SEARCH_PORT=9200
ALTERNATE_SEARCH_PROTOCOL=https
ALTERNATE_SEARCH_AUTH=admin:admin
ALTERNATE_SEARCH_CA_CERTS_PATH=
NUXT_APP_NAME=nuxt-app

# --- Postgres / Supabase backend ------------------------------------------
ALTERNATE_SEARCH_PG_URL=
ALTERNATE_SEARCH_PG_TABLE=
ALTERNATE_SEARCH_PG_ID_COLUMN=id
ALTERNATE_SEARCH_PG_COLUMNS=
ALTERNATE_SEARCH_PG_SSL=false
ALTERNATE_SEARCH_PG_SSL_INSECURE=false

# --- MySQL backend --------------------------------------------------------
ALTERNATE_SEARCH_MYSQL_URL=
ALTERNATE_SEARCH_MYSQL_TABLE=
ALTERNATE_SEARCH_MYSQL_ID_COLUMN=id
ALTERNATE_SEARCH_MYSQL_COLUMNS=

# --- SQLite backend ------------------------------------------------------
ALTERNATE_SEARCH_SQLITE_PATH=
ALTERNATE_SEARCH_SQLITE_TABLE=
ALTERNATE_SEARCH_SQLITE_ID_COLUMN=id
ALTERNATE_SEARCH_SQLITE_COLUMNS=

# --- In-memory backend (tests / demos) ---------------------------------
ALTERNATE_SEARCH_MEMORY_ENABLED=false
ALTERNATE_SEARCH_MEMORY_ID_FIELD=id
ALTERNATE_SEARCH_MEMORY_FIELDS=

# --- Algolia backend ---------------------------------------------------
ALTERNATE_SEARCH_ALGOLIA_APP_ID=
ALTERNATE_SEARCH_ALGOLIA_API_KEY=
ALTERNATE_SEARCH_ALGOLIA_INDEX=

# --- Meilisearch backend ---------------------------------------------
ALTERNATE_SEARCH_MEILISEARCH_HOST=
ALTERNATE_SEARCH_MEILISEARCH_API_KEY=
ALTERNATE_SEARCH_MEILISEARCH_INDEX=
ALTERNATE_SEARCH_MEILISEARCH_ID_FIELD=id

# --- Typesense backend ---------------------------------------------
ALTERNATE_SEARCH_TYPESENSE_HOST=
ALTERNATE_SEARCH_TYPESENSE_PORT=8108
ALTERNATE_SEARCH_TYPESENSE_PROTOCOL=https
ALTERNATE_SEARCH_TYPESENSE_API_KEY=
ALTERNATE_SEARCH_TYPESENSE_COLLECTION=
ALTERNATE_SEARCH_TYPESENSE_ID_FIELD=id

# --- Magento GraphQL source (optional indexing feed) ------------------
MAGENTO_GRAPHQL_URL=
GQL_KEY=

# --- AT Protocol (Bluesky) backend --------------------------------------
# Unlike every other backend above, this is on by default (this deployment
# always has a hosted PDS to search) — set to false to opt out. Uses
# @mframework/adapter-federation's AtprotoClient (app.bsky.feed.searchPosts
# / app.bsky.actor.searchActors). Confirmed live: sky.meeovicms.com rejects
# unauthenticated search requests (401 AuthMissing) — a service-account
# login is required; falls back to ATPROTO_IDENTIFIER/ATPROTO_APP_PASSWORD
# (same account layers/social's useAtprotoClient() bootstrap uses) if the
# ALTERNATE_SEARCH_-prefixed vars are unset.
ALTERNATE_SEARCH_ATPROTO_ENABLED=true
ALTERNATE_SEARCH_ATPROTO_SERVICE=https://sky.meeovicms.com
ALTERNATE_SEARCH_ATPROTO_IDENTIFIER=
ALTERNATE_SEARCH_ATPROTO_PASSWORD=

# --- Prisma / relational fallback ------------------------------------
DATABASE_URL=
NUXT_DATABASE_URL=

# --- Public runtime config ------------------------------------------
# Comma-separated list of index names exposed to the client search UI
NUXT_PUBLIC_SEARCH_INDEXES=
