# Local development environment variables for layers/gateway
# Copy this file to .env and edit values before running `mesh dev` / `mesh build`.
#
# NOTE: this layer is a GraphQL Mesh / Yoga supergraph and is not yet wired
# into any app's `extends`. See mesh.config.ts.

# Directus GraphQL endpoint (CMS subgraph)
DIRECTUS_GRAPHQL=http://localhost:8055/graphql

# Magento GraphQL endpoint (commerce subgraph)
MAGE_MAGENTO_GRAPHQL_URL=

# Shared GraphQL key forwarded to downstream subgraphs
GQL_KEY=
