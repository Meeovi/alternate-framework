{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "noImplicitAny": false,
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@mframework/adapter-gateway": ["../../adapters/adapter-gateway/dist/index.js"],
      "@mframework/adapter-gateway/client": ["../../adapters/adapter-gateway/dist/src/mesh/client.js"],
      "@mframework/adapter-gateway/*/client": ["../../adapters/adapter-gateway/dist/src/mesh/client.js"]
    }
  },
  "include": [
    "*.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "playground",
    "test",
    ".nuxt",
    ".turbo"
  ]
}