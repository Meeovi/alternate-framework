{
  "name": "@mframework/adapter-magento",
  "version": "1.0.0",
  "description": "Official Magento 2 adapter for the M Framework.",
  "repository": "@mframework/adapter-magento",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./module": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "typesVersions": {
    "*": {
      ".": [
        "./src/index.ts"
      ],
      "module": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "mesh:compose": "mesh-compose -o ./src/graphql/supergraph.graphql",
    "mesh:build": "npm run mesh:compose && npm run mesh:codegen",
    "codegen": "graphql-codegen --config codegen.ts",
    "generate": "npm run mesh:build",
    "gqlg": "npx gqlg --schemaFilePath ./schema.graphql --destDirPath ./src/graphql/",
    "prestart": "npm run generate",
    "predev": "npm run generate",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "@nuxt/kit": "^4.0.0"
  },
  "dependencies": {
    "@graphql-hive/gateway": "^2.10.2",
    "@graphql-mesh/compose-cli": "^1.5.33",
    "@graphql-typed-document-node/core": "^3.2.0",
    "adapter-directus": "file:../adapter-directus",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "giget": "^3.3.0",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "ufo": "^1.6.4",
    "unstorage": "^1.17.5"
  },
  "devDependencies": {
    "@0no-co/graphqlsp": "^1.17.3",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.2",
    "@nuxt/a11y": "^1.0.0-alpha.1",
    "@nuxt/devtools": "^3.2.4",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/eslint-config": "^1.15.2",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.4.8",
    "@nuxt/test-utils": "^4.0.3",
    "@parcel/watcher": "^2.6.0",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.4.1",
    "nuxt": "^4.4.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  }
}
