# .env.example - GraphQL Mesh Source Configuration
# Users can configure their backend services here without touching mesh.config.ts

# ============================================
# HTTP/API Sources
# ============================================

# REST API Source Example
MESH_SOURCE_API_ENDPOINT=https://api.example.com
MESH_SOURCE_API_TYPE=rest
MESH_SOURCE_API_HEADERS={}

# GraphQL API Source Example (Shopify)
MESH_SOURCE_SHOPIFY_ENDPOINT=https://your-store.myshopify.com/api/2023-10/graphql.json
MESH_SOURCE_SHOPIFY_TYPE=graphql
MESH_SOURCE_SHOPIFY_HEADERS={"X-Shopify-Storefront-Access-Token":"your-token-here"}

# OpenAPI/Swagger Source Example
MESH_SOURCE_PETSTORE_ENDPOINT=https://petstore3.swagger.io/api/v3
MESH_SOURCE_PETSTORE_TYPE=openapi
MESH_SOURCE_PETSTORE_HEADERS={}

# gRPC Source Example
MESH_SOURCE_GRPC_ENDPOINT=localhost:50051
MESH_SOURCE_GRPC_TYPE=grpc
MESH_SOURCE_GRPC_HEADERS={}

# ============================================
# Database Sources
# ============================================

# Mongoose Source Example (MongoDB)
MESH_SOURCE_DB_ENDPOINT=mongodb://localhost:27017/mydb
MESH_SOURCE_DB_TYPE=mongoose
MESH_SOURCE_DB_HEADERS={}

# MySQL Source Example
MESH_SOURCE_MYSQL_ENDPOINT=mysql://user:password@localhost:3306/mydb
MESH_SOURCE_MYSQL_TYPE=mysql
MESH_SOURCE_MYSQL_HEADERS={}

# MariaDB Source Example
MESH_SOURCE_MARIADB_ENDPOINT=mysql://user:password@localhost:3306/mydb
MESH_SOURCE_MARIADB_TYPE=mariadb
MESH_SOURCE_MARIADB_HEADERS={}

# PostGraphile Source Example (PostgreSQL)
MESH_SOURCE_GRAPHILE_ENDPOINT=postgres://user:password@localhost:5432/mydb
MESH_SOURCE_GRAPHILE_TYPE=postgraphile
MESH_SOURCE_GRAPHILE_HEADERS={"PGHOST":"localhost"}

# ============================================
# Webhooks (for event-driven sources)
# ============================================

MESH_SOURCE_STRIPE_WEBHOOK_ENDPOINT=https://hooks.stripe.com
MESH_SOURCE_STRIPE_WEBHOOK_TYPE=webhook
MESH_SOURCE_STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# Subscriptions
# ============================================

MESH_SOURCE_WS_ENDPOINT=ws://localhost:4000/graphql
MESH_SOURCE_WS_TYPE=subscription
MESH_SOURCE_WS_HEADERS={}

# ============================================
# Security & Rate Limiting
# ============================================

# API Key for authentication
MESH_SECURITY_API_KEY=your-api-key-here

# JWT Secret for JWT authentication
MESH_SECURITY_JWT_SECRET=your-jwt-secret-here

# CORS Origin (comma-separated for multiple)
MESH_SECURITY_CORS_ORIGIN=http://localhost:3000

# Rate Limiting
MESH_RATELIMIT_MAX=100
MESH_RATELIMIT_WINDOW_MS=60000

# Response Caching (seconds)
MESH_CACHE_TTL=300
MESH_CACHE_MAX_SIZE=1000

# ============================================
# Hive Telemetry (optional)
# ============================================

MESH_HIVE_TOKEN=your-hive-token-here
MESH_HIVE_ENDPOINT=https://hive.example.com

# ============================================
# Custom prefix (optional)
# ============================================

# MESH_SOURCE_CUSTOM_PREFIX=MESH_

# ============================================
# Transforms (optional)
# ============================================

# Prefix transform - adds prefix to all types from sources
# MESH_TRANSFORMS_PREFIX=MyApi_

# Rename transform - rename types (format: OldType:NewType,OldType2:NewType2)
# MESH_TRANSFORMS_RENAME=User:Account,Product:StoreProduct

# Naming Convention - convert to camelCase/pascalCase
MESH_TRANSFORMS_NAMING_CONVENTION_TYPES=true
MESH_TRANSFORMS_NAMING_CONVENTION_FIELDS=true
MESH_TRANSFORMS_NAMING_CONVENTION_ROOT=true

# Filter Schema - filter types and fields
# MESH_TRANSFORMS_FILTER_TYPES=User,Product
# MESH_TRANSFORMS_FILTER_FIELDS=User:password,Product:internalId

# Hoist Field - hoist nested fields to parent
# MESH_TRANSFORMS_HOIST_FIELDS=Query:user:me,Query:product:featured

# Encapsulate - encapsulate schema under namespace
# MESH_TRANSFORMS_ENCAPSULATE={"rules":[{"applyTo":"User","remove":false}]}

# Prune - remove unused/deprecated schema elements (default: enabled)
MESH_TRANSFORMS_PRUNE=true

# Federation - enable federation transform
# MESH_TRANSFORMS_FEDERATION=true