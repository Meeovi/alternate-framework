<?xml version="1.0"?>
<!--
  One resource for the read-only routes, so the app's Integration can be
  granted gift card reads and nothing else (see Meeovi_MarketplaceApi's
  acl.xml for why `self` isn't used).
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Meeovi_GiftCards::read" title="Gift Cards for the Meeovi App (read-only)" sortOrder="40"/>
            </resource>
        </resources>
    </acl>
</config>
