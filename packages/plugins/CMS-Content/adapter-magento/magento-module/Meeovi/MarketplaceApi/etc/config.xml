<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <!-- See Model\Payment\External: internal only, never offered at checkout. -->
            <meeovi_external>
                <active>1</active>
                <model>Meeovi\MarketplaceApi\Model\Payment\External</model>
                <order_status>pending</order_status>
                <title>Paid on Meeovi (PayPal)</title>
                <allowspecific>0</allowspecific>
                <group>offline</group>
            </meeovi_external>
        </payment>
    </default>
</config>
