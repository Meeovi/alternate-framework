{
  "name": "@mframework/list-type-kanban",
  "version": "0.1.0",
  "description": "Plug-and-play Kanban list type for M Framework lists: a SVAR Kanban board, run in the integrations sandbox.",
  "mframework": {
    "integration": {
      "name": "Kanban board",
      "description": "Show your lists as a drag-and-drop Kanban board.",
      "category": "Productivity",
      "icon": "fas fa-table-columns",
      "sandbox": "sandbox/index.html"
    }
  },
  "license": "MIT",
  "type": "module",
  "main": "./module.ts",
  "module": "./module.ts",
  "types": "./module.ts",
  "exports": {
    ".": "./module.ts",
    "./module": "./module.ts",
    "./types": "./runtime/types.ts",
    "./components/*": "./runtime/components/*"
  },
  "files": [
    "module.ts",
    "runtime",
    "README.md",
    "sandbox"
  ],
  "scripts": {
    "build": "echo 'list-type-kanban is consumed from source (module.ts); no build step' && exit 0",
    "build:sandbox": "vite build --config sandbox-src/vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "lists",
    "list-type",
    "directus",
    "mframework",
    "meeovi"
  ],
  "author": "Meeovi Labs",
  "dependencies": {
    "@nuxt/kit": "^4.6.1",
    "@svar-ui/vue-kanban": "^2.6.0"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.4.0",
    "vuetify": "^3.0.0"
  },
  "devDependencies": {
    "@nuxt/schema": "^4.6.1",
    "@types/node": "latest",
    "nuxt": "^4.6.1",
    "typescript": "~6.0.3",
    "vue": "^3.5.41",
    "vite": "^8.3.3",
    "@vitejs/plugin-vue": "^6.0.9"
  }
}
