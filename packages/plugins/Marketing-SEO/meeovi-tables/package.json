{
  "name": "@mframework/meeovi-tables",
  "version": "0.1.0",
  "description": "Dynamic data tables for M Framework: SVAR Vue DataGrid over any installed adapter-* (Magento, ...) with Directus as the fallback source and schema.",
  "license": "MIT",
  "type": "module",
  "main": "./module.ts",
  "module": "./module.ts",
  "types": "./module.ts",
  "exports": {
    ".": "./module.ts",
    "./module": "./module.ts",
    "./types": "./runtime/types.ts",
    "./components/*": "./runtime/components/*",
    "./composables/*": "./runtime/composables/*",
    "./sources": "./server/sources/index.ts"
  },
  "files": [
    "module.ts",
    "runtime",
    "server",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'meeovi-tables is consumed from source (module.ts); no build step' && exit 0",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "datagrid",
    "table",
    "svar",
    "directus",
    "magento",
    "mframework",
    "meeovi"
  ],
  "author": "Meeovi Labs",
  "dependencies": {
    "@nuxt/kit": "^4.4.8",
    "@svar-ui/vue-core": "^2.6.0",
    "@svar-ui/vue-editor": "^2.6.0",
    "@svar-ui/vue-grid": "^2.7.0",
    "alternate-sdk": "file:../../Admin/alternate-sdk"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@nuxt/schema": "^4.4.8",
    "@types/node": "latest",
    "nuxt": "^4.6.0",
    "typescript": "~6.0.3",
    "vue": "^3.5.41"
  }
}
