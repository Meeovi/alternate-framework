{
  "name": "@mframework/meeovi-gallery",
  "version": "0.1.0",
  "description": "Media gallery for M Framework: the signed-in user's uploads on Pixanomy in SVAR File Manager, plus a media slider to drop into any page, as a Nuxt module.",
  "license": "MIT",
  "type": "module",
  "main": "./src/module.ts",
  "module": "./src/module.ts",
  "types": "./src/module.ts",
  "exports": {
    ".": "./src/module.ts",
    "./module": "./src/module.ts",
    "./types": "./src/runtime/types.ts",
    "./composables/*": "./src/runtime/composables/*",
    "./server": "./src/runtime/server/utils/gallery.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'meeovi-gallery is consumed from source (src/module.ts); no build step' && exit 0",
    "dev": "nuxt dev playground",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "gallery",
    "media",
    "filemanager",
    "svar",
    "pixanomy",
    "nextcloud",
    "mframework",
    "meeovi"
  ],
  "author": "Meeovi Labs",
  "dependencies": {
    "@nuxt/kit": "^4.6.1",
    "@svar-ui/vue-filemanager": "^2.6.0"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@nuxt/schema": "^4.6.1",
    "@types/node": "latest",
    "h3": "^1.15.0",
    "nuxt": "^4.6.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0",
    "vue": "^3.5.41"
  }
}
