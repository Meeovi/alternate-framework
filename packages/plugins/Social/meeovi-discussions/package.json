{
  "name": "@mframework/meeovi-discussions",
  "version": "0.1.0",
  "description": "Live discussions for M Framework: every note, product, video, space, outlet, \u2026 gets a Rocket.Chat room, embedded with only the chat and signed in through the app session (SSO).",
  "license": "MIT",
  "type": "module",
  "main": "./module.ts",
  "module": "./module.ts",
  "types": "./module.ts",
  "exports": {
    ".": "./module.ts",
    "./module": "./module.ts",
    "./types": "./runtime/types.ts",
    "./components/*": "./runtime/components/*",
    "./server": "./server/utils/rocketchat.ts"
  },
  "files": [
    "module.ts",
    "runtime",
    "server",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'meeovi-discussions is consumed from source (module.ts); no build step' && exit 0",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "discussions",
    "comments",
    "rocket.chat",
    "chat",
    "mframework",
    "meeovi"
  ],
  "author": "Meeovi Labs",
  "dependencies": {
    "@nuxt/kit": "^4.4.8"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@nuxt/schema": "^4.4.8",
    "@types/node": "latest",
    "nuxt": "^4.6.0",
    "typescript": "~6.0.3",
    "vue": "^3.5.41"
  }
}
