{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "baseUrl": ".",
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": [
      "node"
    ],
    "allowSyntheticDefaultImports": true,
    "paths": {
      "#meeovi-ratings": [
        "runtime"
      ],
      "#meeovi-ratings/*": [
        "runtime/*"
      ]
    }
  },
  "include": [
    "module.ts",
    "runtime/**/*.ts",
    "runtime/**/*.vue",
    "server/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
