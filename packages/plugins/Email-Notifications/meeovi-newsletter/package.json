{
  "name": "@mframework/meeovi-newsletter",
  "version": "0.1.0",
  "description": "Backend-agnostic newsletter subscription module for M Framework. Ships a drop-in component, a composable and a Nitro endpoint that dispatches to a pluggable provider (Mailchimp, Directus, ...).",
  "license": "MIT",
  "type": "module",
  "main": "./module.ts",
  "module": "./module.ts",
  "types": "./module.ts",
  "exports": {
    ".": "./module.ts",
    "./module": "./module.ts",
    "./types": "./runtime/types.ts",
    "./components/*": "./runtime/components/*",
    "./composables/*": "./runtime/composables/*",
    "./providers": "./server/providers/index.ts"
  },
  "files": [
    "module.ts",
    "runtime",
    "server",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'meeovi-newsletter is consumed from source (module.ts); no build step' && exit 0",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "newsletter",
    "mailchimp",
    "directus",
    "email",
    "subscribe",
    "mframework",
    "meeovi"
  ],
  "author": "Meeovi Labs",
  "dependencies": {
    "@nuxt/kit": "^4.4.8",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "nuxt": "^4.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@nuxt/schema": "^4.4.8",
    "@types/node": "latest",
    "nuxt": "^4.5.1",
    "typescript": "~6.0.3",
    "vue": "^3.5.41"
  }
}
