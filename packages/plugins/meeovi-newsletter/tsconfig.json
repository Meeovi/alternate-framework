{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "paths": {
      "#meeovi-newsletter": ["runtime"],
      "#meeovi-newsletter/*": ["runtime/*"]
    }
  },
  "include": [
    "module.ts",
    "runtime/**/*.ts",
    "runtime/**/*.vue",
    "server/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
