{
   "name": "officiallyjustus3",
   "type": "module",
   "version": "0.0.5",
   "description": "Officiallyjustu3 is about art that inspires us everyday.",
   "author": "M Framework Labs (https://www.officiallyjustus3.com)",
   "homepage": "https://www.officiallyjustus3.com",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/Meeovi/officiallyJustus3-frontend"
   },
   "bugs": {
      "url": "https://github.com/Meeovi/officiallyJustus3-frontend/issues"
   },
   "license": "MIT",
   "private": true,
   "scripts": {
      "justus-commit": "git add . && git commit -m \"ready for update\"",
      "justus-update": "git pull \"https://github.com/Meeovi/officiallyJustus3-frontend\"",
      "dev": "nuxt dev --host 0.0.0.0",
      "dev-sw": "SW=true nuxi dev",
      "build": "NODE_OPTIONS=--max-old-space-size=6144 nuxt build",
      "build-sw": "SW=true nuxi build",
      "smoke:auth": "bash ./scripts/auth-smoke.sh",
      "ts-node": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}'",
      "generate": "nuxt generate",
      "preview": "nuxt preview",
      "postinstall": "nuxt prepare"
   },
   "dependencies": {
      "@directus/sdk": "^23.0.0",
      "@mframework/ui-shell": "file:../../../../layers/ui-shell",
      "@pinia/nuxt": "^1.0.2",
      "@sentry/nuxt": "^10",
      "@vite-pwa/assets-generator": "^1.0.2",
      "dotenv": "^17.4.2",
      "pinia": "^4.0.3",
      "playwright-core": "^1.59.1"
   },
   "devDependencies": {
      "@parcel/watcher": "^2.6.0",
      "@types/node": "^25.9.5",
      "dotenv-cli": "^11.0.0",
      "nuxt": "^4.6.1",
      "nuxt-layers-utils": "^0.3.1",
      "tsx": "^4.23.1",
      "typescript": "^7.0.2"
   }
}
