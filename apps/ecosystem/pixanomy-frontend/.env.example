# ============================================
# Site Configuration
# ============================================
NUXT_PUBLIC_SITE_URL=http://localhost:3011
NUXT_PUBLIC_SITE_NAME=Meeovi
NUXT_PUBLIC_SITE_DESCRIPTION=Welcome to Meeovi!
NUXT_PUBLIC_SITE_EMAIL=support@example.com

# ============================================
# Application URLs & Metadata
# ============================================
NUXT_APP_URL=http://0.0.0.0:3011 # Base URL of your app
NUXT_APP_NAME=Meeovi
NUXT_APP_NOTIFY_EMAIL=noreply@example.com
NUXT_APP_CONTACT_EMAIL=info@example.com
NUXT_APP_REPO=https://github.com/meeovi/meeovi
NUXT_PROJECT_ID=
NUXT_TRUSTED_ORIGINS=http://localhost:3011
NUXT_NITRO_PRESET=node-server # node-server or cloudflare-module

# ============================================
# Core Gateway & Routing
# ============================================
MAPI_ENDPOINT=http://localhost:3000/api/graphql
AUTH_COOKIE_NAME=auth-token
AUTH_ENDPOINT=https://example.com/graphql
SEARCH_ENDPOINT=https://example.com/graphql
NUXT_PUBLIC_SEARCH_INDEX=default

# ============================================
# Adapter Selection
# ============================================
# Supported values: opensearch, directus, magento
MEEOVI_PROVIDER=opensearch
NUXT_PUBLIC_AUTH_BACKEND=magento

# ============================================
# Auth Configuration
# ============================================
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://0.0.0.0:3011
NUXT_BETTER_AUTH_SECRET=replace-me
AUTH_ISSUER=https://auth.example.com/realms/app
AUTH_AUDIENCE=app-web
NUXT_SESSION_PASSWORD=replace-me
NUXT_PUBLIC_JWT_SECRET=replace-me
# Database provider: drizzle, prisma, pg, mongo, sqlite
BETTER_AUTH_DATABASE_PROVIDER=drizzle
# Plugin configuration via env (custom parsing)
BETTER_AUTH_PLUGINS=twoFactor,username,organization
# Connection string (format depends on provider)
DATABASE_URL=postgresql://user:password@localhost:5432/auth

# ============================================
# Database Configuration
# ============================================
# Supported values: postgresql, mysql, mariadb, sqlite, mongodb, prisma-postgres
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://username:password@localhost:5432/app
NUXT_DATABASE_URL=postgresql://username:password@localhost:5432/app
NUXT_TEST_DATABASE_URL=postgresql://username:password@localhost:5432/app_test
DB_HOST=localhost
DB_PORT=5432
DB_USER=username
DB_PASSWORD=password
DB_NAME=app
NUXT_REDIS_URL=redis://localhost:6379
NUXT_REDIS_PORT=6379
NUXT_REDIS_PASSWORD=

# ============================================
# Directus CMS
# ============================================
DIRECTUS_URL=https://cms.example.com
DIRECTUS_GRAPHQL=https://cms.example.com/graphql
DIRECTUS_STATIC_TOKEN=your_directus_token
NUXTUS_DIRECTUS_AUTH=true
NUXTUS_DIRECTUS_ADMIN_EMAIL=admin@example.com
NUXTUS_DIRECTUS_ADMIN_PASSWORD=admin_password
NUXTUS_DIRECTUS_STATIC_TOKEN=your_static_token
NUXT_PUBLIC_ENABLE_VISUAL_EDITING=true

# ============================================
# Search Configuration (ALTERNATE_SEARCH replaces OPENSEARCH)
# ============================================
# Supported adapters: opensearch, elasticsearch, typesense, memory, algolia, sqlite, pgvector, multi-backend
ALTERNATE_SEARCH_ADAPTER=opensearch
ALTERNATE_SEARCH_PROTOCOL=https
ALTERNATE_SEARCH_HOST=search.example.com
ALTERNATE_SEARCH_PORT=9200
ALTERNATE_SEARCH_URL=https://search.example.com:9200
ALTERNATE_SEARCH_INDEXES=products,articles
ALTERNATE_SEARCH_INDEX=default
ALTERNATE_SEARCH_USERNAME=admin
ALTERNATE_SEARCH_PASSWORD=password
ALTERNATE_SEARCH_ADMIN_API_KEY=your_admin_api_key
ALTERNATE_SEARCH_SEARCH_API_KEY=your_search_api_key

# ============================================
# Magento / eCommerce
# ============================================
MAGE_STORE_URL=https://example.com
MAGE_MAGENTO_GRAPHQL_URL=https://example.com/graphql
MAGENTO_API_URL=https://example.com
MAGENTO_TOKEN=your_magento_token
MAGENTO_BASE_URL=https://example.com
MAGENTO_ACCESS_TOKEN=your_access_token
GQL_KEY=your_consumer_key
GQL_SECRET=your_consumer_secret
WEBSITE_TOKEN=your_website_token
WEBSITE_SECRET=your_website_secret

# ============================================
# WordPress Integration
# ============================================
API_URL_GRAPHQL=http://localhost:8092/graphql
API_URL=http://localhost:8092
WORDPRESS_TOKEN=your_jwt_token
WP_API_EMAIL=admin@example.com
WP_API_PASSWORD=admin_password
WOOCOMMERCE_CONSUMER_KEY=your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=your_consumer_secret

# ============================================
# Supabase
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_public_key

# ============================================
# Storage Configuration
# ============================================
# Supported values: local, r2, s3, minio
STORAGE_PROVIDER=local
NUXT_APP_STORAGE=local
NUXT_LOCAL_UPLOAD_DIR=./uploads
NUXT_LOCAL_PUBLIC_PATH=/uploads
MINIO_ENDPOINT=http://localhost:9000
MINIO_USER=minioadmin
MINIO_PASS=minioadmin

# ============================================
# Image Optimization Configuration
# ============================================
# Supported values: twicpics, cloudinary, imgix, netlify, ipx
IMAGE_OPTIMIZER=twicpics
IMAGE_PROVIDER=twicpics
IMAGE_CDN_DOMAIN=https://example.twic.pics
TWICPICS_DOMAIN=https://example.twic.pics
STORYBOOK_TWICPICS_DOMAIN=https://example.twic.pics

# ============================================
# Payment Configuration
# ============================================
# Supported values: stripe, paypal, polar
PAYMENT_PROVIDER=stripe
NUXT_PAYMENT=stripe

# Stripe
NUXT_STRIPE_SECRET_KEY=sk_test_your_key
NUXT_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
NUXT_STRIPE_WEBHOOK_SECRET=whsec_your_webhook_key
NUXT_STRIPE_PRICE_ID_PRO_MONTH=price_pro_month
NUXT_STRIPE_PRICE_ID_PRO_YEAR=price_pro_year

# PayPal
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_CLIENT_SECRET=your_client_secret
PAYPAL_SANDBOX=true

# Polar
NUXT_POLAR_SERVER=sandbox # sandbox or production
NUXT_POLAR_ACCESS_TOKEN=your_polar_access_token
NUXT_POLAR_WEBHOOK_SECRET=your_polar_webhook_secret
NUXT_POLAR_PRODUCT_ID_PRO_MONTH=your_polar_product_id_month
NUXT_POLAR_PRODUCT_ID_PRO_YEAR=your_polar_product_id_year

# ============================================
# Shipping Providers
# ============================================
UPS_API_KEY=your_ups_api_key
UPS_API_URL=https://onlinetools.ups.com/track/v1/details/
FEDEX_API_KEY=your_fedex_api_key
FEDEX_API_URL=https://apis.fedex.com/
DHL_API_KEY=your_dhl_api_key
DHL_API_URL=https://api-eu.dhl.com/

# ============================================
# Communication Providers
# ============================================
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
NUXT_RESEND_API_KEY=your_resend_api_key

# ============================================
# OAuth / Social Authentication
# ============================================
NUXT_GH_CLIENT_ID=your_github_client_id
NUXT_GH_CLIENT_SECRET=your_github_client_secret
NUXT_GOOGLE_CLIENT_ID=your_google_client_id
NUXT_GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================
# Site Analytics, Captcha, Monitoring
# ============================================
NUXT_PUBLIC_GTAG_ID=your_gtag_id
NUXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
NUXT_TURNSTILE_SECRET_KEY=your_turnstile_secret_key
SENTRY_DSN=

# ============================================
# GraphQL Federation / Apollo / Security
# ============================================
GRAPHQL_URL=http://localhost:3011/graphql
GRAPHQL_KEY=your_graphql_key
GRAPHQL_HEADER_AUTH=Bearer your-auth-token
APOLLO_KEY=your_apollo_api_key
APOLLO_GRAPH_REF=your_graph_id@current
HMAC_SECRET=your_hmac_secret

# ============================================
# Recaptcha
# ============================================
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# ============================================
# Keycloak / Mailchimp
# ============================================
KEYCLOAK_URL=https://auth.example.com
KEYCLOAK_REALM=app
KEYCLOAK_CLIENT_ID=app-web
KEYCLOAK_ISSUER=https://auth.example.com/realms/app
KEYCLOAK_SECRET=your_keycloak_client_secret
KEYCLOAK_REDIRECT_URI=https://example.com/auth/keycloak
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_SERVER_PREFIX=usX
MAILCHIMP_AUDIENCE_ID=your_audience_id

# ============================================
# Test Defaults
# ============================================
NUXT_TEST_APP_URL=http://localhost:3000
NUXT_TEST_EMAIL=test@example.com
NUXT_TEST_PASSWORD=test-password
NUXT_ADMIN_EMAIL=admin@example.com
NUXT_ADMIN_PASSWORD=admin-password
