{
   "name": "@mframework/elitenovels",
   "version": "0.0.9",
   "description": "This is a template for the Elite Novels.",
   "author": "Sebastian Hilton (https://www.sebastianhilton.com)",
   "homepage": "https://www.elitenovels.com",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/Meeovi/elitenovels-frontend"
   },
   "bugs": {
      "url": "https://github.com/Meeovi/elitenovels-frontend/issues"
   },
   "license": "MIT",
   "private": true,
   "scripts": {
      "elite-commit": "git add . && git commit -m \"ready for update\"",
      "elite-update": "git pull \"https://github.com/Meeovi/elitenovels-frontend\"",
      "build": "nuxt build",
      "prebuild": "node ./scripts/copy-images.js",
      "dev": "nuxt dev --port 3010",
      "ts-node": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"CommonJS\"}'",
      "generate": "nuxt generate",
      "preview": "nuxt preview",
      "analyze": "nuxi analyze",
      "postinstall": "nuxt prepare"
   },
   "dependencies": {
      "@directus/sdk": "^26.0.0",
      "@directus/types": "^17.0.0",
      "@fortawesome/fontawesome-free": "^7.3.1",
      "@fortawesome/fontawesome-svg-core": "^7.3.1",
      "@fortawesome/free-solid-svg-icons": "^7.3.1",
      "@fortawesome/vue-fontawesome": "^3.3.3",
      "@mdi/font": "^7.4.47",
      "@nuxt/image": "^2.1.0",
      "@nuxtjs/leaflet": "^1.3.3",
      "@pinia/nuxt": "^1.0.2",
      "@vueuse/core": "^15.0.0",
      "algoliasearch": "^5.59.0",
      "eslint": "^10.11.0",
      "nuxt": "^4.5.2",
      "pinia": "^4.0.3",
      "vuetify": "^3.13.5",
      "vuetify-nuxt-module": "^1.0.0-rc.6"
   },
   "devDependencies": {
      "@nuxtjs/turnstile": "^1.1.3",
      "@storefront-ui/nuxt": "^3.3.3"
   }
}
